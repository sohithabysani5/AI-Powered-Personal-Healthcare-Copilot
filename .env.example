# ==============================================================================
# AI-POWERED PERSONAL HEALTH COPILOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Settings
APP_NAME="AI-Powered Personal Health Copilot"
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database
DATABASE_URL="sqlite:///./health_copilot.db"
# Optional hosted PostgreSQL URI. Prefer the Supabase session pooler URI.
SUPABASE_DB_URL=

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=20971520  # 20 MB

# AI Provider Credentials (Optional - Local deterministic fallback runs automatically if missing)
# 1. xAI Grok
XAI_API_KEY=
XAI_MODEL=grok-beta
XAI_BASE_URL=https://api.x.ai/v1

# 2. Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# 3. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# AI Routing & Resiliency
AI_PROVIDER_ORDER=grok,mistral,gemini
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_RETRIES_PER_PROVIDER=1
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# OCR Settings
TESSERACT_CMD=
TESSERACT_LANGUAGES=eng,hin,tel,tam
